#: src/window.c
msgid "Wipe the keys gently.\nTouchpad and external keyboards still work."
msgstr "Limpia las teclas con suavidad.\nEl panel táctil y los teclados externos siguen funcionando."

#: src/window.c
msgid "Cleaning mode active"
msgstr "Modo limpieza activo"

#: src/window.c
msgid "Stop cleaning"
msgstr "Detener limpieza"

#: src/window.c
msgid "All clean"
msgstr "Todo limpio"

#: src/window.c
msgid "Your keyboard is back."
msgstr "Tu teclado vuelve a funcionar."

#: src/window.c
