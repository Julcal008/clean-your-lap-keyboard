#: src/main.c
msgid "Unknown demo state “%s”. Use idle, countdown, cleaning or done."
msgstr "Estado de demostración desconocido «%s». Usa idle, countdown, cleaning o done."

#: src/main.c
msgid "Duration must be 30, 60 or 120 seconds."
msgstr "La duración debe ser de 30, 60 o 120 segundos."

#: src/main.c
msgid "Could not scan input devices: %s\n"
msgstr "No se pudieron buscar dispositivos de entrada: %s\n"

#: src/main.c
msgid "unknown error"
msgstr "error desconocido"

#: src/main.c
msgid "No keyboards detected."
msgstr "No se detectaron teclados."

#: src/main.c
msgid "List detected keyboards and exit"
msgstr "Muestra los teclados detectados y sale"

#: src/main.c
msgid "Use the keyboard at PATH"
msgstr "Usa el teclado en RUTA"

#: src/main.c
msgid "PATH"
msgstr "RUTA"

#: src/main.c
msgid "Cleaning duration: 30, 60 or 120 seconds"
msgstr "Duración de la limpieza: 30, 60 o 120 segundos"

#: src/main.c
msgid "SECONDS"
msgstr "SEGUNDOS"

#: src/main.c
msgid "Preview a UI state: idle, countdown, cleaning or done"
msgstr "Previsualiza un estado de la interfaz: idle, countdown, cleaning o done"

#: src/main.c
msgid "STATE"
msgstr "ESTADO"

#: src/main.c
msgid "Close automatically after SECONDS (testing)"
msgstr "Cierra automáticamente tras SEGUNDOS (pruebas)"

#: src/main.c
msgid "[OPTION…]"
