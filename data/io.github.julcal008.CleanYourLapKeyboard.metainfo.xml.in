<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.julcal008.CleanYourLapKeyboard</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Clean Your Lap Keyboard</name>
  <summary>Temporarily disable the built-in laptop keyboard so it can be cleaned</summary>
  <developer id="io.github.julcal008">
    <name>Julcal008</name>
  </developer>
  <launchable type="desktop-id">io.github.julcal008.CleanYourLapKeyboard.desktop</launchable>
  <url type="homepage">https://github.com/julcal008/clean-your-lap-keyboard</url>
  <url type="bugtracker">https://github.com/julcal008/clean-your-lap-keyboard/issues</url>
  <description>
    <p>Clean Your Lap Keyboard temporarily grabs the internal keyboard of a laptop so the keys can be wiped without typing anything.</p>
    <p>The touchpad and external keyboards keep working. Cleaning stops automatically after the selected time, when you press the Stop button, or when you hold Esc for two seconds. The keyboard is also released if the screen is locked, the computer suspends, or the session becomes inactive.</p>
    <p>The application does not read, log, or transmit key presses. A small privileged helper performs only the device grab and releases it immediately when asked.</p>
  </description>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>keyboard</keyword>
    <keyword>clean</keyword>
    <keyword>laptop</keyword>
    <keyword>disable</keyword>
  </keywords>
  <provides>
    <binary>cylk</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-10-19">
      <description>
        <p>First public release with automatic keyboard detection, a compact GTK4 interface, and safety releases.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
